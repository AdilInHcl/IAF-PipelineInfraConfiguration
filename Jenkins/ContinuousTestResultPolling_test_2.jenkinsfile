                    catch(Exception ex) {
                        result.retcode = 1
                        result.retdescription = "${ex.getMessage()}"
                        result.retStage = "Combined Email notification for smoke test and security scans"
                        error("Result: ${result}")                                         
                    }
                }
            }
        }
