        stage('Poll Continuous Test Results') {
            //  when {
            //     expression {
            //         def buildCause = currentBuild.getBuildCauses().toString()
            //         return buildCause.contains('TimerTriggerCause') // Execute if scheduled
            //     }
            // }
            steps {
                script {
                    try {

                    def maxRuns = env.LE_Test_Re_Run_MaxLimit.toInteger()
                    def currentRun = 1
                    def continueLoop = true
 
                    while (currentRun <= maxRuns && continueLoop) {

                        dir("LoginEnterpriseConfig") {
                            echo "Running ContinuousTestResult.ps1 script..."
                            // Run the PowerShell script and capture its output
                            psCommand = """ ./Scripts/ContinuousTestResult.ps1 -LE_Test_Re_Run_MaxLimit ${maxRuns} -LE_Test__CurrentRun ${currentRun} """
                            def triggerOutput = runPsWithCreds([[id: 'PROD-LE-Config-Token', type: 'pass', passVar: 'LE_Config_Token'],
                                                                    [id: 'PROD-LE-Read-Token', type: 'pass', passVar: 'LE_Read_Token']], psCommand)
                            
                            checkPsError(triggerOutput, "Poll Continuous Test Results")
                            echo "Output from ContinuousTestResult.ps1:"
                            echo triggerOutput
                           }
                            
                            currentRun++
                            // Sleep for 30 minutes (30 minutes * 60 seconds * 1000 milliseconds)
                            if(currentRun <= maxRuns)
                            {
                            sleep(time: 5, unit: 'MINUTES')
                            // Main script execution
                            // performTaskWithCountdown()
                            echo "Delay complete. Triggering ContinuousTestResult again."
                            }
                    }
                    }
                    catch(Exception ex) {
                            result.retcode = 1
                            result.retdescription = "${ex.getMessage()}"
                            result.retStage = "checked the existing App in LE and New Apps List in AppJson file"
                            error("Result: ${result}")                                         
                    }

                    
                }
            }
        }
        stage("Combined Email Notification") {
